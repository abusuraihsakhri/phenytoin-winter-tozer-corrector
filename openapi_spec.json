{
  "openapi": "3.1.0",
  "info": {
    "title": "Phenytoin Winter–Tozer Calculator API",
    "version": "1.1.0",
    "description": "Research-only correction estimates and optional authenticated audit demo. Live schema is at /openapi.json."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service status JSON"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Operational counters",
        "responses": {
          "200": {
            "description": "JSON counts (not Prometheus text)"
          }
        }
      }
    },
    "/api/correct": {
      "post": {
        "summary": "Estimate corrected total phenytoin concentration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "measured_phenytoin_mg_l": {
                    "type": "number",
                    "minimum": 0
                  },
                  "albumin_g_dl": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "crcl_ml_min": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                },
                "required": [
                  "measured_phenytoin_mg_l",
                  "albumin_g_dl"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correction estimate, formula and conventional-range category"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Demo audit task",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Audit dossier"
          },
          "401": {
            "description": "Bad API key"
          },
          "503": {
            "description": "Key not configured"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Mock-only chat",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "401": {
            "description": "Bad API key"
          },
          "503": {
            "description": "Key not configured"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-process audit entries and HMAC verification",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Audit entries and verification status"
          },
          "401": {
            "description": "Bad API key"
          },
          "503": {
            "description": "Key not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
